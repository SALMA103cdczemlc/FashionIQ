# Copier ce fichier en .env puis ajuster si besoin (aucun secret ici)

# Ressources de chaque Spark Worker
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Port Kafka exposé sur la machine hôte (producteur Python : localhost:9094)
KAFKA_EXTERNAL_PORT=9094

# Image de base Spark (version figée)
SPARK_IMAGE=spark:3.5.3-scala2.12-java17-python3-ubuntu
